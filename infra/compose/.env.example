# Copy to the repo root as .env (not committed). All values blank here on purpose.
# cp infra/compose/.env.example .env

# --- Infra-only (compose + Caddy, not app code) ---
DOMAIN=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Database ---
# Inside compose: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=

# --- Auth.js (web) ---
AUTH_SECRET=
# https://<DOMAIN>
AUTH_URL=
# true behind Caddy
AUTH_TRUST_HOST=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# --- Notifications ---
LINE_MESSAGING_ACCESS_TOKEN=
EMAIL_API_KEY=
EMAIL_FROM=

# --- WebSocket auth: must be identical for web and api ---
WS_TOKEN_SECRET=

# --- AI ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Web push (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@example.com
VAPID_SUBJECT=

# --- Admin ingest (events scraper) ---
ADMIN_INGEST_SECRET=

# --- Public (baked into the web bundle at BUILD time; rebuild web after changing) ---
# https://<DOMAIN>
NEXT_PUBLIC_API_BASE=
# wss://<DOMAIN>/ws
NEXT_PUBLIC_WS_URL=
