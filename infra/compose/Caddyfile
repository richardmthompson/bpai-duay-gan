# Local testing without a domain: set DOMAIN=localhost (Caddy issues a local self-signed cert)
# or replace the site address below with :80 for plain HTTP.

{$DOMAIN} {
	encode zstd gzip

	# Auth.js and the WS token endpoint live in Next.js.
	handle /api/auth/* {
		reverse_proxy web:3000
	}
	handle /api/ws-token {
		reverse_proxy web:3000
	}

	# Node API and WebSocket server. Caddy upgrades WebSockets automatically.
	handle /v1/* {
		reverse_proxy api:4000
	}
	handle /ws {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
